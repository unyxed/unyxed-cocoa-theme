# Unyxed Cocoa Themes: delta features, one per theme. Generated by tools/build.py; do not edit.
# Include this file from ~/.gitconfig and pick a theme (see README):
#   [include]
#       path = <this repo>/ports/delta/unyxed-cocoa-theme.gitconfig
#   [delta]
#       features = <theme-slug>

[delta "cocoa-rose-dark"]
    dark = true
    syntax-theme = Cocoa Rose Dark
    minus-style = syntax "#5E373B"
    minus-emph-style = syntax "#7C4247"
    plus-style = syntax "#4E4838"
    plus-emph-style = syntax "#606040"
    map-styles = bold purple => syntax "#5A3F51", bold cyan => syntax "#3D4C4A"
    line-numbers-minus-style = "#F66C75"
    line-numbers-plus-style = "#A6C062"
    line-numbers-zero-style = "#8B7777"
    line-numbers-left-style = "#3C3133"
    line-numbers-right-style = "#3C3133"
    file-style = "#F0E3DF" bold
    file-decoration-style = "#473C3E" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#473C3E" box
    hunk-header-line-number-style = "#59A5EF"
    commit-decoration-style = "#473C3E" box
    blame-palette = "#382A2D #413336 #433538"

[delta "cocoa-rose-light"]
    light = true
    syntax-theme = Cocoa Rose Light
    minus-style = syntax "#E1C0C1"
    minus-emph-style = syntax "#D29DA2"
    plus-style = syntax "#D1D0BD"
    plus-emph-style = syntax "#B4BB9C"
    map-styles = bold purple => syntax "#D5C1CC", bold cyan => syntax "#C3D0CC"
    line-numbers-minus-style = "#961227"
    line-numbers-plus-style = "#436517"
    line-numbers-zero-style = "#958585"
    line-numbers-left-style = "#DCD1CC"
    line-numbers-right-style = "#DCD1CC"
    file-style = "#3B2A2D" bold
    file-decoration-style = "#D2C6C2" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#D2C6C2" box
    hunk-header-line-number-style = "#004486"
    commit-decoration-style = "#D2C6C2" box
    blame-palette = "#F4EBE7 #EBE1DE #E9DFDC"

