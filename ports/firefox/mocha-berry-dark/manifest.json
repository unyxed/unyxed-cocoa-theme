{
  "manifest_version": 2,
  "name": "Mocha Berry Dark",
  "version": "0.6.0",
  "description": "Mocha Berry Dark, generated from palettes.json.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mocha-berry-dark@unyxed-cocoa-theme",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#2D1D24",
      "frame_inactive": "#2D1D24",
      "tab_background_text": "#B1A2A6",
      "tab_text": "#F1E4E6",
      "tab_selected": "#3A2830",
      "tab_line": "#E78FB3",
      "tab_loading": "#E78FB3",
      "tab_background_separator": "#48393F",
      "toolbar": "#3A2830",
      "toolbar_text": "#F1E4E6",
      "toolbar_field": "#45333B",
      "toolbar_field_text": "#F1E4E6",
      "toolbar_field_border": "#3D2D34",
      "toolbar_field_focus": "#45333B",
      "toolbar_field_text_focus": "#F1E4E6",
      "toolbar_field_border_focus": "#E78FB3",
      "toolbar_field_highlight": "#7E5365",
      "toolbar_field_highlight_text": "#F1E4E6",
      "toolbar_top_separator": "#2D1D24",
      "toolbar_bottom_separator": "#3D2D34",
      "toolbar_vertical_separator": "#48393F",
      "popup": "#433139",
      "popup_text": "#F1E4E6",
      "popup_border": "#48393F",
      "popup_highlight": "#4F3943",
      "popup_highlight_text": "#F1E4E6",
      "sidebar": "#2D1D24",
      "sidebar_text": "#F1E4E6",
      "sidebar_border": "#3D2D34",
      "sidebar_highlight": "#4F3943",
      "sidebar_highlight_text": "#F1E4E6",
      "button_background_hover": "#4C3B42",
      "button_background_active": "#544249",
      "icons": "#CCBEC2",
      "icons_attention": "#E78FB3",
      "ntp_background": "#3A2830",
      "ntp_text": "#F1E4E6",
      "ntp_card_background": "#433139"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
