{
  "manifest_version": 2,
  "name": "Cocoa Copper Dark",
  "version": "0.3.2",
  "description": "Cocoa Copper Dark, generated from palettes.json.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cocoa-copper-dark@unyxed-cocoa-theme",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#2D2221",
      "frame_inactive": "#2D2221",
      "tab_background_text": "#B1A49F",
      "tab_text": "#F1E5DE",
      "tab_selected": "#3A2B2A",
      "tab_line": "#E58076",
      "tab_loading": "#E58076",
      "tab_background_separator": "#483D3B",
      "toolbar": "#3A2B2A",
      "toolbar_text": "#F1E5DE",
      "toolbar_field": "#453635",
      "toolbar_field_text": "#F1E5DE",
      "toolbar_field_border": "#3D3230",
      "toolbar_field_focus": "#453635",
      "toolbar_field_text_focus": "#F1E5DE",
      "toolbar_field_border_focus": "#E58076",
      "toolbar_field_highlight": "#7D504C",
      "toolbar_field_highlight_text": "#F1E5DE",
      "toolbar_top_separator": "#2D2221",
      "toolbar_bottom_separator": "#3D3230",
      "toolbar_vertical_separator": "#483D3B",
      "popup": "#433433",
      "popup_text": "#F1E5DE",
      "popup_border": "#483D3B",
      "popup_highlight": "#4C3A38",
      "popup_highlight_text": "#F1E5DE",
      "sidebar": "#2D2221",
      "sidebar_text": "#F1E5DE",
      "sidebar_border": "#3D3230",
      "sidebar_highlight": "#4C3A38",
      "sidebar_highlight_text": "#F1E5DE",
      "button_background_hover": "#4C3E3C",
      "button_background_active": "#544543",
      "icons": "#CCC0BA",
      "icons_attention": "#E58076",
      "ntp_background": "#3A2B2A",
      "ntp_text": "#F1E5DE",
      "ntp_card_background": "#433433"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
